---
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-sand)] bg-[var(--color-charcoal)]">
    <div class="container-wide grid gap-10 py-16 md:grid-cols-4">
        <div class="md:col-span-1">
            <p class="font-title text-lg font-semibold text-white">{site.shortName}</p>
            <p class="mt-3 text-sm text-[var(--color-stone)]">{site.tagline}</p>
        </div>

        <div>
            <p class="eyebrow">Navigate</p>
            <ul class="mt-3 space-y-2 text-sm text-[var(--color-stone)]">
                <li>
                    <a href={withBase('/services')} class="hover:text-white">
                        Services
                    </a>
                </li>
                <li>
                    <a href={withBase('/portfolio')} class="hover:text-white">
                        Portfolio
                    </a>
                </li>
                <li>
                    <a href={withBase('/about')} class="hover:text-white">
                        About
                    </a>
                </li>
                <li>
                    <a href={withBase('/contact')} class="hover:text-white">
                        Contact
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <p class="eyebrow">Contact</p>
            <ul class="mt-3 space-y-2 text-sm text-[var(--color-stone)]">
                {site.contacts.phones.map((phone) => (
                    <li>
                        <a href={`tel:${phone.value}`} class="hover:text-white">
                            {phone.display ?? phone.value}
                        </a>
                    </li>
                ))}
                {site.contacts.emails.map((email) => (
                    <li>
                        <a href={`mailto:${email.value}`} class="hover:text-white">
                            {email.display ?? email.value}
                        </a>
                    </li>
                ))}
                <li>
                    {site.address.street}, {site.address.area}, {site.address.city}
                </li>
            </ul>
        </div>

        <div>
            <p class="eyebrow">Service areas</p>
            <p class="mt-3 text-sm text-[var(--color-stone)]">{site.emirates.join(' · ')}</p>
        </div>
    </div>

    <div class="border-t border-white/10 py-4 text-center text-xs text-[var(--color-stone)]">
        &copy; <span id="footer-year">{year}</span> {site.name}. All rights reserved.
    </div>
</footer>

<script>
    // Footer persists across View Transitions and the year above is baked in at build time,
    // so recompute it client-side on every page load to avoid showing a stale year to a visitor
    // long after the last deploy.
    document.addEventListener('astro:page-load', () => {
        const el = document.getElementById('footer-year');
        if (el) el.textContent = String(new Date().getFullYear());
    });
</script>
