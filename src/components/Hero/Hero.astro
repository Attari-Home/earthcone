---
import { Image } from 'astro:assets';
import heroImage from '../../images/construction-exteriors/villa-facade-01.jpeg';
import { site } from '../../data/site';
---

<section class="relative overflow-hidden">
    <Image
        src={heroImage}
        alt="Completed villa exterior built by Earth Cone"
        widths={[480, 768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-[var(--color-ink)]/60" aria-hidden="true"></div>

    <div class="container-page relative py-28 sm:py-36">
        <h1 class="max-w-2xl text-4xl font-semibold text-white sm:text-5xl">
            Building and maintaining properties across the UAE
        </h1>
        <p class="mt-4 max-w-xl text-lg text-[var(--color-sand)]">
            {site.tagline}. Licensed to work in {site.emirates.join(', ')}.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
            <a href="/contact" class="btn-primary">
                Request a Quote
            </a>
            <a href="/services" class="btn-secondary bg-white/90">
                Our Services
            </a>
        </div>
    </div>
</section>
