---
import { Image } from 'astro:assets';
import heroConstruction from '../../images/hero/hero-construction.jpeg';
import heroInteriors from '../../images/hero/hero-interiors.jpeg';
import heroKitchens from '../../images/hero/hero-kitchens.jpeg';
import heroElectrical from '../../images/hero/hero-electrical.jpeg';
import heroWaterSystems from '../../images/hero/hero-water-systems.jpeg';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

// Full-bleed hero slideshow: one photo per trade, crossfading on a shared CSS-only loop
// (see .hero-slide / @keyframes hero-crossfade in global.css) — no JS, so it's free
// against the performance budget and still degrades to a single static frame under
// prefers-reduced-motion.
//
// These are curated crops (src/images/hero/), not the raw portfolio photos directly:
// most source shots are portrait/phone-camera framed, and object-cover center-crop of a
// portrait image inside this wide banner showed an arbitrary, often unflattering sliver
// (e.g. the water-systems shot centered on plain tile instead of the mashrabiya panel).
// Each hero-*.jpeg is hand-cropped to the actual subject at roughly the banner's aspect
// ratio — see docs/project-memory.md for the source photo + crop window per slide.
const slides = [
    { src: heroConstruction, alt: 'Completed villa exterior built by Earth Cone' },
    { src: heroInteriors, alt: 'Marble feature wall interior fit-out, Dubai villa' },
    { src: heroKitchens, alt: 'Custom kitchen cabinetry installation, Dubai villa' },
    { src: heroElectrical, alt: 'Electrical conduit installation, UAE construction site' },
    { src: heroWaterSystems, alt: 'Ablution area washroom fixture installation, UAE building' },
];
---

<section class="relative flex h-[calc(100vh-5rem)] min-h-[560px] items-end overflow-hidden bg-[var(--color-ink)]">
    {slides.map((slide, i) => (
        <Image
            src={slide.src}
            alt={slide.alt}
            widths={[480, 768, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'low'}
            class="hero-slide absolute inset-0 h-full w-full object-cover"
            style={`animation-delay: ${i * 6}s, 0s`}
        />
    ))}
    <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)] via-[var(--color-ink)]/55 to-[var(--color-ink)]/10"
        aria-hidden="true"
    ></div>

    <div class="container-wide relative pt-24 pb-12 sm:pt-28 md:pb-16">
        <p class="reveal eyebrow text-white/80">Est. Dubai · UAE-wide</p>
        <h1
            class="hero-headline reveal mt-3 max-w-3xl text-display-lg font-semibold text-white"
            style="transition-delay: 0.1s"
        >
            Building and maintaining properties across the UAE
        </h1>
        <p class="reveal mt-6 max-w-xl text-lg text-white/80" style="transition-delay: 0.2s">
            {site.tagline}. Licensed to work in {site.emirates.join(', ')}.
        </p>
        <div class="reveal mt-8 flex flex-wrap gap-4" style="transition-delay: 0.3s">
            <a href={withBase('/contact')} class="btn-primary">
                {' '}
                Request a Quote{' '}
            </a>
            <a href={withBase('/services')} class="btn-secondary bg-white/90">
                {' '}
                Our Services{' '}
            </a>
        </div>
    </div>

    <a
        href="#what-we-do"
        aria-label="Scroll to content"
        class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-white/70 transition-colors hover:text-white sm:block"
    >
        <svg width="20" height="32" viewBox="0 0 20 32" fill="none" aria-hidden="true">
            <rect
                x="1"
                y="1"
                width="18"
                height="30"
                rx="9"
                stroke="currentColor"
                stroke-width="1.5"
            />
            <circle class="animate-scroll-dot" cx="10" cy="10" r="2" fill="currentColor" />
        </svg>
    </a>
</section>
