---
import { Image } from 'astro:assets';
import heroConstruction from '../../images/hero/frames-for-your-heart-_KP6mk2Iz8k-unsplash.jpg';
import heroInteriors from '../../images/hero/aalo-lens-UlIj_qKpgCw-unsplash.jpg';
import heroKitchens from '../../images/hero/brian-zajac-n8wF-38dASg-unsplash.jpg';
import heroElectrical from '../../images/hero/pexels-ranamatloob567-35189704.jpg';
import heroWaterSystems from '../../images/hero/shoham-avisrur-Kskxj4M8jmI-unsplash.jpg';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

// Full-bleed hero slideshow: one photo per trade, crossfading on a shared CSS-only loop
// (see .hero-slide / @keyframes hero-crossfade in global.css) — no JS, so it's free
// against the performance budget and still degrades to a single static frame under
// prefers-reduced-motion.
//
// Images sourced from Unsplash and Pexels — see docs/project-memory.md for full
// attribution and original URLs per slide. All images processed through astro:assets
// for automatic AVIF/WebP conversion and responsive srcset generation.
const slides = [
    {
        src: heroConstruction,
        alt: 'Luxury modern villa exterior with palm trees, completed by Earth Cone Contracting',
    },
    {
        src: heroInteriors,
        alt: 'High-end marble and dark wood interior fit-out with gold accents, Dubai villa',
    },
    {
        src: heroKitchens,
        alt: 'Custom white and gold luxury kitchen with marble island, designed and installed by Earth Cone',
    },
    {
        src: heroElectrical,
        alt: 'Premium kitchen featuring designer ring LED chandelier and luxury electrical fit-out, UAE',
    },
    {
        src: heroWaterSystems,
        alt: 'Modern kitchen with integrated plumbing fixtures and sleek cabinetry, Earth Cone water systems',
    },
];
---

<section class="relative flex h-[calc(100vh-5rem)] min-h-[560px] items-end overflow-hidden bg-[var(--color-ink)]">
    {slides.map((slide, i) => (
        <Image
            src={slide.src}
            alt={slide.alt}
            widths={[480, 768, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'low'}
            class="hero-slide absolute inset-0 h-full w-full object-cover"
            style={`animation-delay: ${i * 6}s, 0s`}
        />
    ))}
    <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)] via-[var(--color-ink)]/55 to-[var(--color-ink)]/10"
        aria-hidden="true"
    ></div>

    <div class="container-wide relative pt-24 pb-12 sm:pt-28 md:pb-16">
        <p class="hero-reveal eyebrow text-white/80">Est. Dubai · UAE-wide</p>
        <h1
            class="hero-headline mt-3 max-w-3xl text-display-lg font-semibold text-white"
            style="animation-delay: 0.1s"
        >
            Building and maintaining properties across the UAE
        </h1>
        <p class="hero-reveal mt-6 max-w-xl text-lg text-white/80" style="animation-delay: 0.2s">
            {site.tagline}. Licensed to work in {site.emirates.join(', ')}.
        </p>
        <div class="hero-reveal mt-8 flex flex-wrap gap-4" style="animation-delay: 0.3s">
            <a href={withBase('/contact')} class="btn-primary">
                {' '}
                Request a Quote{' '}
            </a>
            <a href={withBase('/services')} class="btn-secondary bg-white/90">
                {' '}
                Our Services{' '}
            </a>
        </div>
    </div>

    <a
        href="#what-we-do"
        aria-label="Scroll to content"
        class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-white/70 transition-colors hover:text-white sm:block"
    >
        <svg width="20" height="32" viewBox="0 0 20 32" fill="none" aria-hidden="true">
            <rect
                x="1"
                y="1"
                width="18"
                height="30"
                rx="9"
                stroke="currentColor"
                stroke-width="1.5"
            />
            <circle class="animate-scroll-dot" cx="10" cy="10" r="2" fill="currentColor" />
        </svg>
    </a>
</section>
