---
import { primaryWhatsapp } from '../../data/site';
import { withBase } from '../../lib/url';
---

<section class="bg-[var(--color-terracotta-dark)] py-section-sm">
    <div class="container-page flex flex-col items-center gap-5 text-center text-white">
        <p class="eyebrow text-white/90">Let's build it</p>
        <h2 class="text-display-sm font-display font-semibold">Have a project in mind?</h2>
        <p class="max-w-xl text-white/90">
            Tell us about your construction, fit-out, or maintenance project and we'll get back to
            you with a quote.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a
                href={withBase('/contact')}
                class="btn-secondary bg-white text-[var(--color-ink)] hover:bg-white/90"
            >
                Request a Quote
            </a>
            <a
                href={`https://wa.me/${primaryWhatsapp.value}`}
                class="btn-secondary border-white text-white hover:bg-white/10"
            >
                WhatsApp Us
            </a>
        </div>
    </div>
</section>
