---
import { site, primaryPhone, primaryEmail, LICENSE_PLACEHOLDER } from '../../data/site';

interface Props {
    title: string;
    description: string;
    /**
     * Text for og:description / twitter:description when it should read differently from the
     * <meta name="description"> SERP snippet — e.g. the homepage keeps `description` tight
     * (~155 chars, avoids Google truncating it) but wants a fuller summary of the company and
     * its trades on the link-preview card social apps render when the URL is shared.
     * Falls back to `description` when omitted.
     */
    ogDescription?: string;
    /** Absolute or root-relative path to a social preview image. */
    image?: string;
}

const { title, description, ogDescription = description, image = '/og-default.jpg' } = Astro.props;

const pageTitle = title.includes(site.shortName) ? title : `${title} | ${site.shortName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'GeneralContractor',
    name: site.name,
    description: site.description,
    telephone: primaryPhone.value,
    email: primaryEmail.value,
    address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.address.street}, ${site.address.area}`,
        addressLocality: site.address.city,
        addressCountry: site.address.country,
    },
    areaServed: site.emirates.map((emirate) => ({
        '@type': 'AdministrativeArea',
        name: emirate,
    })),
    contactPoint: [
        ...site.contacts.phones.map((phone) => ({
            '@type': 'ContactPoint',
            telephone: phone.value,
            contactType: 'customer service',
            areaServed: 'AE',
        })),
        ...site.contacts.whatsapp.map((wa) => ({
            '@type': 'ContactPoint',
            telephone: `+${wa.value}`,
            contactType: 'customer service',
            areaServed: 'AE',
        })),
    ],
    identifier:
        site.license.number === LICENSE_PLACEHOLDER
            ? undefined
            : {
                  '@type': 'PropertyValue',
                  propertyID: 'Trade License Number',
                  value: site.license.number,
              },
    url: Astro.site,
};
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
