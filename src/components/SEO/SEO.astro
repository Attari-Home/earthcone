---
import { site, primaryPhone, primaryEmail, LICENSE_PLACEHOLDER } from '../../data/site';
import { withBase } from '../../lib/url';

interface Props {
    title: string;
    description: string;
    /**
     * Text for og:description / twitter:description when it should read differently from the
     * <meta name="description"> SERP snippet — e.g. the homepage keeps `description` tight
     * (~155 chars, avoids Google truncating it) but wants a fuller summary of the company and
     * its trades on the link-preview card social apps render when the URL is shared.
     * Falls back to `description` when omitted.
     */
    ogDescription?: string;
    /** Absolute or root-relative path to a social preview image. */
    image?: string;
    /** Alt text for a custom `image`; the default image carries its own. */
    imageAlt?: string;
}

const DEFAULT_OG_IMAGE = {
    src: '/og-image.jpg',
    width: 1200,
    height: 630,
    alt: 'Tower cranes silhouetted against a warm sunset sky over a building under construction',
};

const {
    title,
    description,
    ogDescription = description,
    image = DEFAULT_OG_IMAGE.src,
    imageAlt,
} = Astro.props;
const isDefaultImage = image === DEFAULT_OG_IMAGE.src;

const pageTitle = title.includes(site.shortName) ? title : `${title} | ${site.shortName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The GitHub Pages staging site is public and byte-identical to production, so search
// engines must be told to keep it out of the index — otherwise it competes with the real
// domain for the same queries. Canonical stays self-referential on purpose: pointing it at
// production while also sending noindex risks that signal carrying over to the real page.
const isStaging = import.meta.env.PUBLIC_DEPLOY_TARGET === 'staging';
// Root-relative image paths need the base prefix before they are resolved against the
// origin — on staging (served from /earthcone/) a bare `/og-image.jpg` would 404.
const ogImageURL = new URL(image.startsWith('http') ? image : withBase(image), Astro.site);

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'GeneralContractor',
    name: site.name,
    description: site.description,
    telephone: primaryPhone.value,
    email: primaryEmail.value,
    address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.address.street}, ${site.address.area}`,
        addressLocality: site.address.city,
        addressCountry: site.address.country,
    },
    areaServed: site.emirates.map((emirate) => ({
        '@type': 'AdministrativeArea',
        name: emirate,
    })),
    contactPoint: [
        ...site.contacts.phones.map((phone) => ({
            '@type': 'ContactPoint',
            telephone: phone.value,
            contactType: 'customer service',
            areaServed: 'AE',
        })),
        ...site.contacts.whatsapp.map((wa) => ({
            '@type': 'ContactPoint',
            telephone: `+${wa.value}`,
            contactType: 'customer service',
            areaServed: 'AE',
        })),
    ],
    identifier:
        site.license.number === LICENSE_PLACEHOLDER
            ? undefined
            : {
                  '@type': 'PropertyValue',
                  propertyID: 'Trade License Number',
                  value: site.license.number,
              },
    url: Astro.site,
};
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{isStaging && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
{isDefaultImage ? (
    <>
        <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE.height)} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:alt" content={DEFAULT_OG_IMAGE.alt} />
        <meta name="twitter:image:alt" content={DEFAULT_OG_IMAGE.alt} />
    </>
) : (
    <>
        <meta property="og:image:type" content="image/jpeg" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    </>
)}
<meta property="og:site_name" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
