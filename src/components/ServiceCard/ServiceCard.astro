---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
    service: CollectionEntry<'services'>;
    delay?: number;
}

const { service, delay = 0 } = Astro.props;
const { title, summary, heroImage } = service.data;
---

<a
    href={`/services/${service.id}`}
    class="group media-tile reveal block"
    style={`transition-delay: ${delay}s`}
>
    <div class="aspect-[4/3] overflow-hidden bg-[var(--color-sand)]">
        {heroImage && (
            <Image
                src={heroImage}
                alt={`${title} — completed Earth Cone project work`}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                class="h-full w-full object-cover"
            />
        )}
    </div>
    <div class="mt-4">
        <h3 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-terracotta)]">
            {title}
        </h3>
        <p class="mt-1 text-sm text-[var(--color-stone)]">{summary}</p>
        <span class="btn-ghost mt-3 text-[var(--color-terracotta)]">
            View service <span class="arrow">&rarr;</span>
        </span>
    </div>
</a>
