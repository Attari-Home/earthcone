---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { withBase } from '../../lib/url';

interface Props {
    service: CollectionEntry<'services'>;
    delay?: number;
}

const { service, delay = 0 } = Astro.props;
const { title, summary } = service.data;

// Custom scope illustrations, not stock glyphs: an armchair/cooking pot misread as furniture/catering.
const SERVICE_ICONS: Record<string, string> = {
    construction: 'services/construction',
    interiors: 'services/interiors',
    kitchens: 'services/kitchens',
    electrical: 'services/electrical',
    'water-systems': 'services/water-systems',
};
const icon = SERVICE_ICONS[service.id] ?? 'ph:wrench';
---

<a
    href={withBase(`/services/${service.id}`)}
    class="group reveal block border border-[var(--color-sand)] p-8 transition-colors duration-300 hover:border-[var(--color-terracotta)]"
    style={`transition-delay: ${delay}s`}
>
    <span class="flex h-24 w-24 items-center justify-center rounded-[2px] border border-[var(--color-terracotta)]/30 bg-[var(--color-terracotta)]/[0.08] text-[var(--color-terracotta)] transition-colors duration-300 group-hover:border-transparent group-hover:bg-[var(--color-terracotta-dark)] group-hover:text-white">
        <Icon name={icon} class="h-18 w-18" />
    </span>
    <h3 class="mt-6 text-lg font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-terracotta)]">
        {title}
    </h3>
    <p class="mt-2 text-sm text-[var(--color-stone)]">{summary}</p>
    <span class="btn-ghost mt-4 text-[var(--color-terracotta-dark)]">
        View service <span class="arrow">&rarr;</span>
    </span>
</a>
