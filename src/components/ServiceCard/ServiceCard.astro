---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/url';

interface Props {
    service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { title, summary } = service.data;
---

<a
    href={withBase(`/services/${service.id}`)}
    class="group block rounded-lg border border-[var(--color-sand)] bg-white p-6 transition-shadow hover:shadow-lg"
>
    <h3 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-terracotta)]">
        {title}
    </h3>
    <p class="mt-2 text-sm text-[var(--color-stone)]">{summary}</p>
</a>
