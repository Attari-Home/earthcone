---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { withBase } from '../../lib/url';

interface Props {
    service: CollectionEntry<'services'>;
    delay?: number;
}

const { service, delay = 0 } = Astro.props;
const { title, summary } = service.data;

// Icon-led card on purpose: this is a capability list ("what we do"), deliberately not a
// photo grid, so it reads distinct from the photo-driven Portfolio tiles (ServiceGrid and
// the homepage portfolio teaser used to share the same media-tile treatment, which read as
// duplicate sections).
const SERVICE_ICONS: Record<string, string> = {
    construction: 'ph:hard-hat',
    interiors: 'ph:armchair',
    kitchens: 'ph:cooking-pot',
    electrical: 'ph:lightning',
    'water-systems': 'ph:drop',
};
const icon = SERVICE_ICONS[service.id] ?? 'ph:wrench';
---

<a
    href={withBase(`/services/${service.id}`)}
    class="group reveal block border border-[var(--color-sand)] p-8 transition-colors duration-300 hover:border-[var(--color-terracotta)]"
    style={`transition-delay: ${delay}s`}
>
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-sand)] text-[var(--color-terracotta-dark)] transition-colors duration-300 group-hover:bg-[var(--color-terracotta-dark)] group-hover:text-white">
        <Icon name={icon} class="h-7 w-7" />
    </span>
    <h3 class="mt-6 text-lg font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-terracotta)]">
        {title}
    </h3>
    <p class="mt-2 text-sm text-[var(--color-stone)]">{summary}</p>
    <span class="btn-ghost mt-4 text-[var(--color-terracotta-dark)]">
        View service <span class="arrow">&rarr;</span>
    </span>
</a>
