---
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

const navLinks = [
    { href: '/services', label: 'Services' },
    { href: '/portfolio', label: 'Portfolio' },
    { href: '/service-areas', label: 'Service Areas' },
    { href: '/recognition', label: 'Recognition' },
    { href: '/faq', label: 'FAQ' },
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-20 border-b border-[var(--color-sand)] bg-[var(--color-cream)]/90 backdrop-blur-md">
    <div class="container-wide flex h-20 items-center justify-between">
        <a
            href={withBase('/')}
            class="flex items-center gap-2.5 font-title text-lg font-semibold tracking-tight text-[var(--color-fg)]"
        >
            <img src={withBase('/logo-mark.png')} alt="" width="36" height="36" class="h-9 w-9" />
            {site.shortName}
        </a>

        <nav aria-label="Primary" class="hidden gap-5 xl:gap-7 lg:flex">
            {navLinks.map((link) => (
                <a
                    href={withBase(link.href)}
                    class="link-underline text-sm font-medium text-nowrap text-[var(--color-fg)] hover:text-[var(--color-terracotta)]"
                >
                    {link.label}
                </a>
            ))}
        </nav>

        <a href={withBase('/contact')} class="btn-primary hidden text-xs lg:inline-flex">
            Get a Quote
        </a>

        <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="flex h-10 w-10 items-center justify-center text-[var(--color-fg)]"
        >
            <Icon name="ph:sun" class="icon-sun h-5 w-5" />
            <Icon name="ph:moon" class="icon-moon h-5 w-5" />
        </button>

        <details id="mobile-nav" class="relative lg:hidden">
            <summary
                class="flex h-10 w-10 cursor-pointer list-none items-center justify-center text-[var(--color-fg)] [&::-webkit-details-marker]:hidden"
                aria-label="Open menu"
            >
                <Icon name="ph:list" class="h-6 w-6" />
            </summary>
            <nav
                aria-label="Primary"
                class="absolute top-full right-0 z-10 mt-2 w-48 border border-[var(--color-sand)] bg-[var(--color-cream)] p-2 shadow-lg"
            >
                {navLinks.map((link) => (
                    <a
                        href={withBase(link.href)}
                        class="block px-3 py-2 text-sm font-medium text-[var(--color-fg)] hover:bg-[var(--color-sand)]"
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
        </details>
    </div>
</header>

<script>
    // Header persists across View Transitions (transition:persist), so the mobile <details>
    // menu's open state would otherwise survive client-side navigations. Force it closed
    // whenever a new page finishes swapping in.
    document.addEventListener('astro:page-load', () => {
        const menu = document.getElementById('mobile-nav');
        if (menu instanceof HTMLDetailsElement) menu.open = false;
    });

    // Delegated on `document` (which is never replaced) rather than bound directly to the
    // button: `transition:persist` on <Header> does not keep the same button node across a
    // client-side navigation here, so a listener attached to that specific element stops
    // receiving clicks after the first page. This script itself still only runs once —
    // Astro dedupes non-inline <script> tags across navigations — so delegation is both
    // the fix and doesn't need re-binding on astro:page-load.
    document.addEventListener('click', (event) => {
        const button = event.target instanceof Element && event.target.closest('#theme-toggle');
        if (!button) return;
        const current =
            document.documentElement.getAttribute('data-theme') ??
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
    });
</script>
