---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    before: ImageMetadata;
    after: ImageMetadata;
    beforeLabel?: string;
    afterLabel?: string;
    alt: string;
}

const { before, after, beforeLabel = 'Before', afterLabel = 'After', alt } = Astro.props;
---

<div class="before-after relative aspect-[4/3] w-full overflow-hidden rounded-[2px] select-none">
    <Image
        src={after}
        alt={`${alt} — after`}
        widths={[480, 768, 1024]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    />
    <div
        class="before-after-clip pointer-events-none absolute inset-0 h-full overflow-hidden"
        style="width: 50%"
    >
        <Image
            src={before}
            alt={`${alt} — before`}
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="lazy"
            class="absolute inset-0 h-full w-full max-w-none object-cover"
            style="width: var(--bas-w, 100vw)"
        />
    </div>

    <span class="pointer-events-none absolute top-3 left-3 rounded-[2px] bg-[var(--color-ink)]/70 px-2.5 py-1 text-xs font-medium tracking-wide text-white uppercase">
        {beforeLabel}
    </span>
    <span class="pointer-events-none absolute top-3 right-3 rounded-[2px] bg-[var(--color-ink)]/70 px-2.5 py-1 text-xs font-medium tracking-wide text-white uppercase">
        {afterLabel}
    </span>

    <div
        class="before-after-handle pointer-events-none absolute top-0 bottom-0 w-0.5 bg-white"
        style="left: 50%"
    >
        <div
            class="absolute top-1/2 left-1/2 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[var(--color-ink)] shadow-lg"
            aria-hidden="true"
        >
            ↔
        </div>
    </div>

    <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label={`Drag to compare before and after: ${alt}`}
        class="before-after-input absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent opacity-0"
    />
</div>

<script>
    // Each slider computes its own clip width from the range input's value — scoped per
    // instance via closest('.before-after') so multiple sliders on one page don't collide.
    // Delegated on `document` (see Header.astro's theme-toggle fix for why: a listener bound
    // directly to a specific input can outlive its element across a client-side navigation).
    function updateSlider(input: HTMLInputElement) {
        const root = input.closest('.before-after');
        const clip = root?.querySelector<HTMLElement>('.before-after-clip');
        const handle = root?.querySelector<HTMLElement>('.before-after-handle');
        const img = clip?.querySelector<HTMLElement>('img');
        if (!clip || !handle || !img) return;
        const pct = `${input.value}%`;
        clip.style.width = pct;
        handle.style.left = pct;
        // The inner <img> is width:100% of an inset-clipped container, which would shrink
        // the photo itself as the container narrows — pin it back to the slider's full
        // width so only the visible crop changes, not the image's own scale.
        img.style.width = `${(root as HTMLElement).clientWidth}px`;
    }

    document.addEventListener('input', (event) => {
        const input = event.target;
        if (input instanceof HTMLInputElement && input.classList.contains('before-after-input')) {
            updateSlider(input);
        }
    });

    function initAll() {
        document.querySelectorAll<HTMLInputElement>('.before-after-input').forEach(updateSlider);
    }

    initAll();
    document.addEventListener('astro:page-load', initAll);
    window.addEventListener('resize', initAll);
</script>
