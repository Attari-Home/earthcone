---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
    title="About"
    description={`${site.name} is headquartered in Dubai and licensed to operate across the UAE.`}
>
    <section class="container-page py-16">
        <h1 class="text-3xl font-semibold text-[var(--color-ink)]">About {site.shortName}</h1>
        <p class="mt-4 max-w-2xl text-[var(--color-stone)]">
            {site.description} We handle construction, interior fit-out, custom kitchens,
            electrical, and water-systems work for residential and commercial clients across
            {site.emirates.join(', ')}.
        </p>
    </section>
</BaseLayout>
