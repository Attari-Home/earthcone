---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand/CtaBand.astro';
import { site, LICENSE_PLACEHOLDER } from '../data/site';
import { withBase } from '../lib/url';

const trades = [
    { name: 'Construction', href: '/services/construction' },
    { name: 'Interior Fit-Out', href: '/services/interiors' },
    { name: 'Custom Kitchens', href: '/services/kitchens' },
    { name: 'Korean Marble', href: '/services/korean-marble' },
    { name: 'Electrical', href: '/services/electrical' },
    { name: 'Water Systems', href: '/services/water-systems' },
];
---

<BaseLayout
    title="About"
    description={`${site.name} is headquartered in Dubai and licensed to operate across the UAE.`}
>
    <section class="relative overflow-hidden py-section-md">
        <p class="display-word top-0 -left-4" aria-hidden="true">
            About
        </p>
        <div class="container-wide relative">
            <div class="reveal">
                <p class="eyebrow">About</p>
                <h1 class="mt-2 max-w-2xl text-display-md font-semibold text-[var(--color-fg)]">
                    About {site.shortName}
                </h1>
                <p class="mt-6 max-w-2xl text-lg text-[var(--color-stone)]">
                    {site.description} We handle construction, interior fit-out, custom kitchens,
                    Korean marble, electrical, and water-systems work for residential and commercial
                    clients across {site.emirates.join(', ')}.
                </p>
                <p class="mt-4 max-w-2xl text-[var(--color-stone)]">
                    Every trade below is run by Earth Cone's own crew rather than subcontracted out,
                    so the same team — and the same point of contact — stays on a project from the
                    first site visit to handover, whichever Emirate it's in.
                </p>
            </div>

            <ul class="reveal mt-10 flex flex-wrap gap-3" style="transition-delay: 0.1s">
                {trades.map((trade) => (
                    <li>
                        <a
                            href={withBase(trade.href)}
                            class="inline-block rounded-full border border-[var(--color-sand)] px-4 py-2 text-sm font-medium text-[var(--color-fg)] transition-colors duration-300 hover:border-[var(--color-terracotta-dark)] hover:text-[var(--color-terracotta-dark)]"
                        >
                            {trade.name}
                        </a>
                    </li>
                ))}
            </ul>

            <dl
                class="reveal mt-14 grid gap-8 border-t border-[var(--color-sand)] pt-10 sm:grid-cols-3"
                style="transition-delay: 0.15s"
            >
                <div>
                    <dt class="eyebrow">Headquarters</dt>
                    <dd class="mt-2 text-[var(--color-fg)]">
                        {site.address.street}, {site.address.area}, {site.address.city}
                    </dd>
                </div>
                <div>
                    <dt class="eyebrow">Coverage</dt>
                    <dd class="mt-2 text-[var(--color-fg)]">All seven Emirates</dd>
                </div>
                {site.license.number !== LICENSE_PLACEHOLDER && (
                    <div>
                        <dt class="eyebrow">Trade license</dt>
                        <dd class="mt-2 text-[var(--color-fg)]">{site.license.number}</dd>
                    </div>
                )}
            </dl>
        </div>
    </section>

    <CtaBand />
</BaseLayout>
