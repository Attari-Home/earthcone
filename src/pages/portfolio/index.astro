---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand/CtaBand.astro';
import { getMediaForFolder } from '../../lib/portfolioMedia';
import { withBase } from '../../lib/url';
import { site } from '../../data/site';

const categories = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const tiles = categories.map((category) => {
    const [first] = getMediaForFolder(category.data.folder);
    const cover = first ? (first.kind === 'photo' ? first.src : first.poster) : null;
    return { category, cover };
});
---

<BaseLayout
    title="Portfolio"
    description={`Browse completed construction, interiors, kitchens, electrical, and water-systems work by ${site.shortName}.`}
>
    <section class="container-wide py-section-md">
        <div class="reveal">
            <p class="eyebrow">Portfolio</p>
            <h1 class="mt-2 max-w-2xl text-display-md font-semibold text-[var(--color-ink)]">
                Our work, by category
            </h1>
            <p class="mt-4 max-w-xl text-[var(--color-stone)]">
                A look at completed Earth Cone projects across the UAE, organized by trade.
            </p>
        </div>

        <div class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {tiles.map(({ category, cover }, i) => (
                <a
                    href={withBase(`/portfolio/${category.id}`)}
                    class="group media-tile tilt-card reveal block"
                    style={`transition-delay: ${Math.min(i * 0.08, 0.32)}s`}
                >
                    <div class="aspect-[4/3] overflow-hidden bg-[var(--color-sand)]">
                        {cover && (
                            <Image
                                src={cover}
                                alt={`${category.data.title} — Earth Cone portfolio`}
                                widths={[320, 480, 640]}
                                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                                loading="lazy"
                                class="h-full w-full object-cover"
                            />
                        )}
                    </div>
                    <div class="mt-4">
                        <h2 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-terracotta)]">
                            {category.data.title}
                        </h2>
                        <p class="mt-1 text-sm text-[var(--color-stone)]">
                            {category.data.summary}
                        </p>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <CtaBand />
</BaseLayout>
