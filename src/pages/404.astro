---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
    <section class="container-page py-section-lg text-center">
        <p class="eyebrow justify-center">404</p>
        <h1 class="mt-2 text-display-md font-semibold text-[var(--color-fg)]">Page not found</h1>
        <p class="mt-4 text-[var(--color-stone)]">
            We couldn't find that page.{' '}
            <a href={withBase('/')} class="link-underline text-[var(--color-terracotta)]">
                Go home
            </a>
            .
        </p>
    </section>
</BaseLayout>
