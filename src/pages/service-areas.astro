---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand/CtaBand.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

// Short, genuine per-Emirate context rather than separate thin "service in [city]" pages —
// see CLAUDE.md §4: one substantial page naming every Emirate beats duplicate-content doorway
// pages. Deliberately factual (no invented project counts or testimonials per Emirate).
const emirateNotes: Record<string, string> = {
    Dubai: "Earth Cone's head office — most site visits and project starts happen here.",
    'Abu Dhabi': 'Villa and property work across the capital, dispatched from Dubai.',
    Sharjah: 'Construction, fit-out, and maintenance for residential and commercial properties.',
    Ajman: 'Full-trade coverage — construction, interiors, kitchens, electrical, and plumbing.',
    'Ras Al Khaimah': 'Villa construction and maintenance work, run by the same Dubai-based crew.',
    Fujairah: "The UAE's east-coast Emirate — reached by the same licensed crew as the rest.",
    'Umm Al Quwain':
        'Construction and maintenance projects, scoped with the same site-visit process.',
};
---

<BaseLayout
    title="Service Areas"
    description={`${site.shortName} is licensed to work across all seven Emirates: ${site.emirates.join(', ')}.`}
>
    <section class="container-wide py-section-md">
        <div class="reveal">
            <p class="eyebrow">Service Areas</p>
            <h1 class="mt-2 max-w-2xl text-display-md font-semibold text-[var(--color-fg)]">
                Where we work
            </h1>
            <p class="mt-6 max-w-2xl text-lg text-[var(--color-stone)]">
                {site.shortName} is headquartered in {site.address.city} and licensed to take on
                construction and maintenance projects in every Emirate — construction, interior
                fit-out, custom kitchens, Korean marble, electrical, and water systems, run by the
                same in-house crew wherever the job is.
            </p>
        </div>

        <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {site.emirates.map((emirate, i) => (
                <li
                    class="reveal border-t border-[var(--color-sand)] py-5"
                    style={`transition-delay: ${i * 0.05}s`}
                >
                    <p class="font-display text-lg font-medium text-[var(--color-fg)]">{emirate}</p>
                    <p class="mt-1 text-sm text-[var(--color-stone)]">{emirateNotes[emirate]}</p>
                </li>
            ))}
        </ul>

        <div class="reveal mt-16 flex flex-wrap gap-x-10 gap-y-4 border-t border-[var(--color-sand)] pt-8">
            <a
                href={withBase('/recognition')}
                class="btn-ghost text-[var(--color-terracotta-dark)]"
            >
                Recognition <span class="arrow">&rarr;</span>
            </a>
            <a href={withBase('/faq')} class="btn-ghost text-[var(--color-terracotta-dark)]">
                Frequently asked questions <span class="arrow">&rarr;</span>
            </a>
        </div>
    </section>

    <CtaBand />
</BaseLayout>
