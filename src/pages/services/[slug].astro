---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand/CtaBand.astro';
import PortfolioCard from '../../components/PortfolioCard/PortfolioCard.astro';
import { getMediaForFolder } from '../../lib/portfolioMedia';
import { withBase } from '../../lib/url';
import { site } from '../../data/site';

export async function getStaticPaths() {
    const services = await getCollection('services');
    return services.map((service) => ({
        params: { slug: service.id },
        props: { service },
    }));
}

const { service } = Astro.props;
const { title, summary, heroImage } = service.data;
const { Content } = await render(service);

// Service-plus-location phrasing for the <title>/OG tag (what people actually search —
// "kitchen installation Dubai", not just "kitchens") without cluttering the on-page <h1>,
// which stays the clean service name.
const seoTitles: Record<string, string> = {
    construction: 'Construction Services in Dubai & the UAE',
    interiors: 'Interior Fit-Out Services in Dubai & the UAE',
    kitchens: 'Custom Kitchen Design & Installation in the UAE',
    electrical: 'Electrical Installation Services in Dubai & the UAE',
    'water-systems': 'Plumbing & Water Systems Installation in the UAE',
};
const pageTitle = seoTitles[service.id] ?? title;

// The projects collection holds the portfolio media for each service (matched via
// serviceSlug). Only a short teaser runs here — the full set (46 photos for kitchens)
// belongs on /portfolio/[category], and printing it on both pages made the service page a
// visual duplicate of the portfolio page rather than a page about the service.
const GALLERY_TEASER_COUNT = 6;
const projectCategories = await getCollection('projects');
const matchingProject = projectCategories.find((p) => p.data.serviceSlug === service.id);
const allGalleryItems = matchingProject ? getMediaForFolder(matchingProject.data.folder) : [];
// One tile per subject (basename minus its trailing sequence number): taking the first six
// items outright lands on six near-identical shots of the same job, since the media sorts
// by basename and most subjects have several numbered variants.
const seenSubjects = new Set<string>();
const galleryItems = allGalleryItems
    .filter((item) => {
        const subject = item.basename.replace(/-\d+$/, '');
        if (seenSubjects.has(subject)) return false;
        seenSubjects.add(subject);
        return true;
    })
    .slice(0, GALLERY_TEASER_COUNT);
const hasMoreGalleryItems = allGalleryItems.length > galleryItems.length;

const serviceJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: title,
    description: summary,
    serviceType: title,
    areaServed: site.emirates.map((emirate) => ({
        '@type': 'AdministrativeArea',
        name: emirate,
    })),
    provider: {
        '@type': 'GeneralContractor',
        name: site.name,
        url: Astro.site,
    },
};
---

<BaseLayout title={pageTitle} description={summary}>
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline></script>
    <Breadcrumbs
        items={[
            { label: 'Home', href: '/' },
            { label: 'Services', href: '/services' },
            { label: title, href: `/services/${service.id}` },
        ]}
    />
    <article>
        {heroImage && (
            <div class="bleed relative h-[45vh] min-h-[320px] overflow-hidden">
                <Image
                    src={heroImage}
                    alt={`${title} — completed Earth Cone project work`}
                    widths={[768, 1280, 1920]}
                    sizes="100vw"
                    loading="eager"
                    class="h-full w-full object-cover"
                />
                <div class="absolute inset-0 bg-[var(--color-ink)]/40" aria-hidden="true"></div>
            </div>
        )}

        <div class="container-page max-w-3xl py-section-sm">
            <div class="reveal">
                <p class="eyebrow">Service</p>
                <h1 class="mt-2 text-display-sm font-semibold text-[var(--color-fg)]">{title}</h1>
                <p class="mt-4 text-lg text-[var(--color-stone)]">{summary}</p>
                <div class="prose mt-8 max-w-none">
                    <Content />
                </div>
            </div>
        </div>

        {galleryItems.length > 0 && (
            <div class="container-wide pt-6 pb-section-sm">
                <div class="reveal flex flex-wrap items-end justify-between gap-4">
                    <h2 class="text-display-sm font-display font-semibold text-[var(--color-fg)]">
                        Completed {title.toLowerCase()} work
                    </h2>
                    {matchingProject && (
                        <a
                            href={withBase(`/portfolio/${matchingProject.id}`)}
                            class="btn-ghost text-[var(--color-terracotta-dark)]"
                        >
                            {hasMoreGalleryItems
                                ? `See all ${allGalleryItems.length} projects`
                                : 'View full gallery'}
                            <span class="arrow">&rarr;</span>
                        </a>
                    )}
                </div>
                <div class="mt-10 columns-1 gap-6 sm:columns-2 lg:columns-3">
                    {galleryItems.map((item) => (
                        <PortfolioCard item={item} />
                    ))}
                </div>
            </div>
        )}
    </article>

    <CtaBand />
</BaseLayout>
