---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceGrid from '../../components/ServiceGrid/ServiceGrid.astro';
import CtaBand from '../../components/CtaBand/CtaBand.astro';
import { site } from '../../data/site';
---

<BaseLayout
    title="Services"
    description={`Construction, interior fit-out, custom kitchens, electrical installation, and water-systems services from ${site.shortName} — licensed across Dubai and all seven Emirates.`}
>
    <section class="container-wide py-section-md">
        <div class="reveal">
            <p class="eyebrow">Services</p>
            <h1 class="mt-2 text-display-md font-semibold text-[var(--color-fg)]">Our Services</h1>
        </div>
        <div class="mt-14">
            <h2 class="sr-only">All services</h2>
            <ServiceGrid />
        </div>
    </section>

    <CtaBand />
</BaseLayout>
