---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO/SEO.astro';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import { withBase } from '../lib/url';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/castoro-titling';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <script is:inline>
            document.documentElement.classList.add('js');
            // Runs synchronously before first paint so there's no flash of the wrong
            // theme. Falls through to the @media(prefers-color-scheme) CSS when nothing
            // is stored, i.e. the visitor never explicitly toggled the theme.
            const storedTheme = localStorage.getItem('theme');
            if (storedTheme) document.documentElement.setAttribute('data-theme', storedTheme);
        </script>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
        <SEO title={title} description={description} image={image} />
        <ClientRouter />
    </head>
    <body class="flex min-h-screen flex-col">
        <Header transition:persist />
        <main class="flex-1">
            <slot />
        </main>
        <Footer transition:persist />
    </body>

    <script>
        const io = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        io.unobserve(entry.target);
                    }
                }
            },
            { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
        );

        function observeReveals() {
            document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => io.observe(el));
        }

        observeReveals();
        document.addEventListener('astro:page-load', observeReveals);
    </script>
</html>
