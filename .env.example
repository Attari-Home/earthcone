# Web3Forms access key used by the contact form. Use the STAGING form's key here for
# local dev so test submissions don't land in the real leads inbox. The production
# build (Cloudflare) should be configured with the PRODUCTION form's key instead —
# a separate Web3Forms form with hCaptcha spam protection enabled. See CLAUDE.md §11.
WEB3FORMS_KEY=

# Optional: Cloudflare Web Analytics beacon token.
CF_BEACON_TOKEN=
